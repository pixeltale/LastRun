; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Gash"        ;Name of character
displayname = "Gash" ;Name of character to display
versiondate = 09,30,2009    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
ikemenversion = 1.0
author = "PXN."         ;Character author name
pal.defaults = 1,2,3,4      ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = Gash.cds           ;Command set
cns     = Gash.cns           ;Constants
st      = Gash.cns           ;States
st1		= NORMALS.CNS
st2		= SPECIALS.CNS
stcommon = common.cns      ;Common states (from data/ or motif)
sprite  = Gash.sff           ;Sprite
anim    = Gash.air           ;Animation
sound   = Gash.snd           ;Sound
ai      = Gash.ai            ;AI hints data (not used)
movelist1 = movelist.dat     ;Ikemen feature: Movelist
movelist2 = movelist1.dat
movelist3 = movelist2.dat

; Maps character selection buttons to palette numbers.
[Palette Keymap]
x = 4 ;Press button X to select palette 1, etc.
y = 5
z = 6
a = 1
b = 2
c = 3
x2 = 7 ;Hold Start and press button X for palette 7, etc.
y2 = 8
z2 = 9
a2 = 10
b2 = 11
c2 = 12

; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def
