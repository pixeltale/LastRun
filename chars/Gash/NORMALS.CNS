guard.slidetime 		= 8
guard.velocity 		= -10
airguard.velocity 		= -2,-1
;===============================
ground.cornerpush.veloff	= -8
air.cornerpush.veloff 	= -8
down.cornerpush.veloff 	= -4
guard.cornerpush.veloff 	= -4
;===============================
fall 				= 0
air.fall 				= 1
;===============================
envshake.time 			= 15
envshake.freq 			= 15
envshake.ampl 			= 4
envshake.phase 		= 0.5

