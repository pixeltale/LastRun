guard.ctrltime 	= 10
guard.slidetime	= 10
airguard.velocity 	= -3,-.8
air.velocity 		= -5,-4 / root, map(JuggleScale)
envshake.time 		= 0;
air.fall 			= 1
fall.yvelocity 	= 0
;=====================================
envshake.time 		= 3
envshake.freq 		= 5
envshake.ampl 		= 2
envshake.phase 	= 1
getpower 			= 50

