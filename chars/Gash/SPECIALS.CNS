[State -2, P1 Value Set]
type 		= RootMapSet
trigger1 		= movehit && root, map(ComboStateCheck) = 0
map 			= "P1"
value 		= 0.85
ignorehitpause 	= 1
[State -2, P2 Value Set]
type 		= RootMapSet
trigger1 		= movehit && root, map(ComboStateCheck)
map 			= "P2"
value 		= 0.90	;85% DMG For next hit
ignorehitpause 	= 1
persistent = 0
[State -2, P2 Accumulation - Scale]
type 		= RootMapSet
trigger1 		= movehit
map 			= "Accumulation"
value 		= Root, Map(Accumulation) * Root, map(P2)
ignorehitpause 	= 1
persistent 		= 0

[State 200, 1]
type = HitDef 
trigger1 	= !MoveContact && !MoveReversed
attr = SCA, SP
damage 		= 120 * (root, map(P4)), 5
animtype 		= light                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
air.animtype 	= back
guardflag 	= M
hitflag 		= MAF
pausetime 		= 1, 1 + 2 * (enemy, movetype = A)
sparkno 			= 0
sparkxy 			= 0, -10
hitsound 			= 5, 1
guardsound 		= 6, 0
ground.slidetime 	= 20
ground.hittime  	= 20
air.hittime  		= 999
down.hittime 		= 15
ground.velocity 	= -2
guard.ctrltime 	= 10
guard.slidetime	= 10
airguard.velocity 	= -3,-.8
air.velocity 		= -5,-4 / root, map(JuggleScale)
envshake.time 		= 0;
air.fall 			= 1
fall.yvelocity 	= 0
;=====================================
envshake.time 		= 3
envshake.freq 		= 5
envshake.ampl 		= 2
envshake.phase 	= 1
getpower 			= 50

