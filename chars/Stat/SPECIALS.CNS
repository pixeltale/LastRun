[Statedef 1001]
type    		= S
movetype		= A
physics 		= S
velset 		= vel x, 0
ctrl 		= 0
anim 		= 1001
facep2 		= 1
poweradd 		= 0
sprpriority 	= 2

[State -2, P1 Value Set]
type 		= MapSet
trigger1 		= movehit && !map(ComboStateCheck)
map 			= "P1"
value 		= 1	;100% Starting DMG
ignorehitpause 	= 1
[State -2, P2 Value Set]
type 		= MapSet
trigger1 		= movehit && map(ComboStateCheck)
map 			= "P2"
value 		= 1	;85% DMG For next hit
ignorehitpause 	= 1
persistent = 0
[State -2, P2 Accumulation - Scale]
type 		= MapSet
trigger1 		= movehit
map 			= "Accumulation"
value 		= Map(Accumulation) * map(P2)
ignorehitpause 	= 1
persistent 		= 0

[State -2, P1 Value Set]
type 		= MapSet
trigger1 		= !time
map 			= "PunchCharge"
value 		= 0
ignorehitpause 	= 1
[State -2, P1 Value Set]
type 		= MapAdd
triggerall	= map(PunchCharge) < 2 && animelemno(0) = 2
trigger1 		= time = 20 || time = 40
map 			= "PunchCharge"
value 		= 1
ignorehitpause 	= 1
persistent		= 1

[State 0, JORMUNGANDR DEFAULT HITDEF]
type 				= HitDef
trigger1 				= !movecontact && !movereversed
;===============================
damage 				= 120 * map(P4) + 40 * map(PunchCharge)
pausetime 			= 14,14 + 2 * map(PunchCharge) + 4 * (movecountered)
getpower 				= 100 * map(P4) + 60 * map(PunchCharge)
;===============================
attr 				= S,SA
hitflag 				= MAF
guardflag 			= M
animtype 				= Light
air.animtype 			= Light
ground.TYPE 			= High
air.TYPE 				= High
;===============================
sparkno 				= 2
sparkxy 				= -p2dist x * 0.25, -100
hitsound 				= 5,2
guardsound 			= 6,0
;===============================
ground.hittime  			= 18 + (4 * map(PunchCharge))
ground.slidetime			= 18 + (4 * map(PunchCharge))
ground.velocity 			= -5
air.hittime  			= 30
air.velocity 			= -3.5,0
down.velocity 			= -1,-5
down.hittime 			= 30
;===============================
guard.ctrltime 		= 16 + 3*map(PunchCharge)
guard.slidetime 		= 16 + 3*map(PunchCharge)
guard.velocity 		= -10
airguard.velocity 		= -2,-1
;===============================
ground.cornerpush.veloff	= -5
air.cornerpush.veloff 	= -5
down.cornerpush.veloff 	= -4
guard.cornerpush.veloff 	= -4
;===============================
fall 				= 0
air.fall 				= 1
;===============================
envshake.time 			= 15
envshake.freq 			= 15
envshake.ampl 			= 4
envshake.phase 		= 0.5

[State 0, VelAdd]
type = PosAdd
triggerall = anim = 1001
trigger1 = animelemno(0) = 3
x = 12

[State 0, VelAdd]
type = PosAdd
triggerall = map(Attraction)||combocount
triggerall = anim = 1001
trigger1 = animelemno(0) > 1 && animelemno(0) < 3
x = cond(time * 0.2 < 15, time * 0.2, 15) * cond(p2dist x < 0, -1, 1) + 1.5 * (movetype=H)
redirectid = enemy, id
[State 0, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 1
priority = 2
;ignorehitpause = 
;persistent = 
[State Test] ;Dont Clip Through on Release
type = Width
trigger1 = 1
value = 10, 10

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = anim = 1001
trigger1 = animelemno(0) = 2
trigger1 = command = "HOLD_B" && time < 100
value = 1001 
elem = 2

[State -2, Feint Checker]
type 		= MapSet
trigger1 		= !time || movehitvar(overridden)
map 			= "Feint"
value 		= 0
[State -2, Feint Checker]
type 		= MapSet
trigger1 		= command = "D"
map 			= "Feint"
value 		= 1
[State 0, Anim]
type 		= ChangeAnim
triggerall 	= anim != 231
trigger1 		= map(Feint) && animelemno(0) = 2
value 		= 231

[State -2, Fatal Attraction Set]
