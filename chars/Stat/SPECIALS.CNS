;214A Pawnch
[Statedef 1000]
type    		= S
movetype		= A
physics 		= S
velset 		= 0, 0
ctrl 		= 0
anim 		= 1000
facep2 		= 1
poweradd 		= 0
sprpriority 	= 2

[State -2, P1 Value Set]
type 		= MapSet
trigger1 		= movehit && !map(ComboStateCheck)
map 			= "P1"
value 		= 1	;100% Starting DMG
ignorehitpause 	= 1
[State -2, P2 Value Set]
type 		= MapSet
trigger1 		= movehit && map(ComboStateCheck)
map 			= "P2"
value 		= 0.90	;85% DMG For next hit
ignorehitpause 	= 1
persistent = 0
[State -2, P2 Accumulation - Scale]
type 		= MapSet
trigger1 		= movehit
map 			= "Accumulation"
value 		= Map(Accumulation) * map(P2)
ignorehitpause 	= 1
persistent 		= 0

[State 0, JORMUNGANDR DEFAULT HITDEF]
type 				= HitDef
trigger1 				= !movecontact && !movereversed
;===============================
damage 				= 70 * map(P4)
pausetime 			= 14,14 + 4 * (movecountered)
getpower 				= 100 * map(P4)
;===============================
attr 				= S,NA
hitflag 				= MAF
guardflag 			= M
animtype 				= Light
air.animtype 			= Light
ground.TYPE 			= High
air.TYPE 				= High
;===============================
sparkno 				= 2
sparkxy 				= -p2dist x * 0.25, -100
hitsound 				= 5,2
guardsound 			= 6,0
;===============================
ground.hittime  			= 18
ground.slidetime			= 18
ground.velocity 			= -5
air.hittime  			= 30
air.velocity 			= -3.5,0
down.velocity 			= -1,-5
down.hittime 			= 30
;===============================
guard.ctrltime 		= 16
guard.slidetime 		= 16
guard.velocity 		= -10
airguard.velocity 		= -2,-1
;===============================
ground.cornerpush.veloff	= -5
air.cornerpush.veloff 	= -5
down.cornerpush.veloff 	= -4
guard.cornerpush.veloff 	= -4
;===============================
fall 				= 0
air.fall 				= 1
;===============================
envshake.time 			= 15
envshake.freq 			= 15
envshake.ampl 			= 4
envshake.phase 		= 0.5

[State 0, PosAdd]
type = PosAdd
trigger1 = animelemno(0) = 2
x = 8

[State -2, Fatal Attraction Set]
type 		= MapSet
trigger1 		= movecontact
map 			= "Attraction"
value 		= 200
ignorehitpause 	= 1
[State -2, Lamb To Slaughter - Starter]
type 		= MapSet
trigger1 		= movecontact || animelem = 5
map 			= "LS_ACancel"
value 		= 1
ignorehitpause 	= 1
[State -2, Lamb To Slaughter - Starter]
type 		= MapSet
trigger1 		= movecontact || animelem = 5
map 			= "LS_BCancel"
value 		= 1
ignorehitpause 	= 1

[State 200, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

