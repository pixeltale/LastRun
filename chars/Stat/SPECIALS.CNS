ignorehitpause 	= 1
persistent 		= 0

[State 0, JORMUNGANDR DEFAULT HITDEF]
type 				= HitDef
trigger1 				= !movecontact && !movereversed
;===============================
damage 				= 70 * map(P4)
pausetime 			= 14,14 + 4 * (movecountered)
getpower 				= 100 * map(P4)
;===============================
attr 				= S,NA
hitflag 				= MAF
guardflag 			= M
animtype 				= Light
air.animtype 			= Light
ground.TYPE 			= High
air.TYPE 				= High
;===============================
sparkno 				= 2
sparkxy 				= -p2dist x * 0.25, -100
hitsound 				= 5,2
guardsound 			= 6,0
;===============================
ground.hittime  			= 18
ground.slidetime			= 18
ground.velocity 			= -5
air.hittime  			= 30
air.velocity 			= -3.5,-1 / map(JuggleScale)
down.velocity 			= -1,-5
down.hittime 			= 30
;===============================
guard.ctrltime 		= 16
guard.slidetime 		= 16
guard.velocity 		= -10
airguard.velocity 		= -2,-1
;===============================
ground.cornerpush.veloff	= -5
air.cornerpush.veloff 	= -5
down.cornerpush.veloff 	= -4
guard.cornerpush.veloff 	= -4
;===============================
fall 				= 0
air.fall 				= 1
;===============================
envshake.time 			= 15
envshake.freq 			= 15
envshake.ampl 			= 4
envshake.phase 		= 0.5

