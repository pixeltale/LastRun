trigger1 = !AILevel && StateType = C && command != "holddown"
trigger2 = AILevel && ceil(random<(100*(AILevel**2/64.0)));(random<100+(5*var(54)))
trigger2 = statetype=C && (enemynear,movetype=A) && (enemynear,statetype!=C)
statetype = S
physics = S

