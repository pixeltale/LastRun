[State 1200, Shake Screen]
type = EnvShake
trigger1 = time % 20 = 0
time = 5    ;Time to shake screen
ampl = -2     ;Amount to shake
freq = 120

[State 0, ModifyExplod]
type = MakeDust
trigger1 = time % 5 = 0

[State 0, PosSet]
type = PosSet
trigger1 = time = 0
y = 0

[State 0, VelMul]
type = VelMul
trigger1 = 1
x = .91

[State 0, ChangeState]
type = SelfState
trigger1 = time > gethitvar(ctrltime)
value = 5110
ctrl = 0

