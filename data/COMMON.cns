;===============================================================================
; ------- Combo State Checker --------
;===============================================================================
[State -2, Combo State Check]
type = MapSet
triggerall = enemy, stateno != [120, 155]
trigger1 = enemy, movetype = H
map = "ComboStateCheck"
value = 1
ignorehitpause = 1
persistent = 1
[State -2, Combo State Check]
type = MapSet
trigger1 = enemy, movetype != H
map = "ComboStateCheck"
value = 0
ignorehitpause = 1


;======================================
;PURSUIT Section
;======================================

;Build Pursuit for Aggression
[State 0, MapSet] 
type = MapAdd
triggerall = vel x > 0
trigger1 = !combocount
map = "Pursuit"
value = floor(vel x * 0.4) + statetype = A
[State 0, MapSet] 
type = MapAdd
trigger1 = movecontact && !movehitvar(overridden)
map = "Pursuit"
value = enemy,gethitvar(damage) * 0.7
ignorehitpause = 1
[State 0, MapSet] 
type = MapAdd
trigger1 = enemy, stateno = [150, 153]
map = "Pursuit"
value = 1
ignorehitpause = 1

[State 0, MapSet] ;Player has MAX Pursuit Value. Cannot be depleted by blocking or deadzones.
type = MapSet
trigger1 = MAP(PURSUIT) >= 999
map = "Pursuit.MAX"
value = 1
ignorehitpause = 1
[State 0, MapSet] ;Player has MAX Pursuit Value. Cannot be depleted by blocking or deadzones.
type = MapSet
trigger1 = MAP(PURSUIT) < 999
map = "Pursuit.MAX"
value = 0
ignorehitpause = 1
[State 0, MapSet] ;Upper Limit
type = MapSet
trigger1 = MAP(PURSUIT) > 999
map = "Pursuit"
value = 999
ignorehitpause = 1
[State 0, MapSet] ;Lower Limit
type = MapSet
trigger1 = MAP(PURSUIT) <= 0
map = "Pursuit"
value = 0
ignorehitpause = 1

;======================================
;TERMINA Calculations
;======================================
[State 0, MapSet] ;Deplete
type = MapAdd
trigger1 = stateno < 3000  || movetype = H      ;Dont deplete during supers or starutp anim
trigger1 = map(TERMINA.ACTIVE)
map = "TERMINA.TIME"
value = -1
ignorehitpause = 0
persistent = 1
[State 0, MapSet] ;END
type = MapSet
trigger1 = map(TERMINA.TIME) <= 0
map = "TERMINA.ACTIVE"
value = 0
ignorehitpause = 1
[State 0, MapSet] ;END
type = MapSet
trigger1 = map(TERMINA.ACTIVE) = 1
map = "PURSUIT"
value = 999 * (map(TERMINA.TIME)/600)
ignorehitpause = 1


