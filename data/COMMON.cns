map = "CounterHit"
value = 1
ignorehitpause = 1
[State -2, CH Check - 1] 				;Checks if the opponent is
type = MapSet	                        ;attacking or not
trigger1 = enemynear, movetype != A
map = "CounterHit"
value = 0
ignorehitpause = 1

[State -2, CH - Read for Start Flag] 				;Checks if the opponent is
