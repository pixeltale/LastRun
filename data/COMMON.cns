trigger1 = prevstateno != [135,137]
map = "BGuard"
value = 0

[State 0, Turn]
type = Turn
trigger1 = !time
trigger1 = p2dist x < 0

[State 0, MapSet] ;Instant Block Check
type = MapSet
trigger1 = time = 0
map = "IBCheck"
value = cond(map(IBTimer) > 20, 1, 0)

[State 0, MapSet] ;Instant Block Timer Reset
type = MapSet
trigger1 = time = 1 && map(IBTimer)
map = "IBTimer"
value = 0

[State 0, Changestate] ;Guard Crush
type = Changestate
trigger1 = Map(GC)=1 && BackEdgeBodyDist <=0
value = 5240

[State 154, End]
type=changestate
trigger1= hitshakeover
value=155

;-------------------------------------------------------------------------------
;AGUARDHIT2
[Statedef 155]
type=A
movetype=H
physics=N
anim=152

[State 151, Vel]
type = VelSet
trigger1 = !time
x = gethitvar(xvel) * facing * map(BGuard_SlideMul)
y = gethitvar(yvel)

[State 155, Vel]
type = veladd
trigger1 = 1
y = 0.4 + 0.2*(pos y > -10)  - 0.1 *(map(GC))

[State 151, Ctrl]
type = ctrlset
trigger1 = time = gethitvar(ctrltime) - cond(map(IBCheck), 2 - 2 * map(BGuard_Penalty), -2 * map(BGuard_Penalty))
value = 1
ignorehitpause = 0
persistent = 0

[State 155, Var]
type=varset
trigger1= 1
sysvar(0)=(pos y>=0 && vel y>0)
[State 155, Vel]
type=velset
trigger1= sysvar(0)
y=0
[State 155, Pos]
type=posset
trigger1= sysvar(0)
y=0

[State 0, Changestate] ;Guard Crush
type = Changestate
trigger1 = Map(GC)=1 && BackEdgeBodyDist <=0 && !map(BGuard)
value = 5240

[State 155, End]
type = changestate
trigger1 = sysvar(0) && inguarddist
trigger1 = command = "holdback"
value = 130
[State 155, End]
type = changestate
trigger1 = sysvar(0)
value = 52

