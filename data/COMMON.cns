;===============================================================================
; ------- DAMAGE PRORATION --------
;===============================================================================
[State -2, Combo Rate Calculation - Normal Hit]
type 		= MapSet
trigger1 	= combocount && !map(CHStarter)
map 		= "CR"
value 		= 0.80	;80% DMG Limit
ignorehitpause 	= 1
[State -2, Combo Rate Calculation - Counter Hit]
type 		= MapSet
trigger1 	= combocount && map(CHStarter)
map 		= "CR"
value 		= 0.90
ignorehitpause 	= 1

[State -2, P2 - Accumulation - Start]
type 		= MapSet
trigger1 	= enemy, movetype = H && map(P2Limit) = 0
map 		= "Accumulation"
value 		= 1
ignorehitpause 	= 1
persistent 		= 0

[State -2, P2 - Accumulation - Limit]
type 		= MapSet
trigger1 	= map(Accumulation) > 0
map 		= "P2Limit"
value 		= 1
ignorehitpause 	= 1
persistent 		= 0

[State -2, P4 - Total Proration Calculation]
type 		= MapSet
trigger1 	= enemy, movetype = H
map 		= "P4"
value 		= cond(map(P4) <= 0.05, 0.05, (map(P1)*map(Accumulation)*map(CR)))
ignorehitpause 	= 1
persistent 		= 0


[State -2, P1 Proration Reset]
type = MapSet
trigger1 = enemy, movetype != H
map = "P1"
value = 1
[State -2, P2 Proration Reset]
type = MapSet
trigger1 = enemy, movetype != H
map = "P2"
value = 1
[State -2, P2 Proration Reset]
type = MapSet
trigger1 = enemy, movetype != H
map = "Accumulation"
value = 1
[State -2, Combo Rate Reset]
type = MapSet
trigger1 = enemy, movetype != H
map = "CR"
value = 1
[State -2, P4 Proration Reset]
type = MapSet
trigger1 = enemy, movetype != H
map = "P4"
value = 1
[State -2, P2 Limit Reset]
type = MapSet
trigger1 = enemy, movetype != H
map = "P2Limit"
value = 0

