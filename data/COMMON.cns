map 		= "reSplat"
value 		= 3
ignorehitpause 	= 1
[State -2, Splat Value Set]
type 		= MapSet
trigger1 	= !map(comboStateCheck) && map(custom_ReSplatCount)
map 		= "reSplat"
value 		= map(Custom_resplatCount)
ignorehitpause 	= 1
[State -2, Splat Value Set]
type 		= MapAdd
trigger1 	= enemy, stateno = [5225, 5228]
trigger1	= movehit = 1
map 		= "reSplat"
value 		= -1
ignorehitpause 	= 0
persistent	= 0

[State -2, Corner Only WallSplat Check]
type 		= MapSet
trigger1 	= 1
map 		= "cornerSplat"
value 		= cond((abs(camerapos x) > 260 && frontedgedist < 250) && (stagefrontedgedist < stagebackedgedist), 5225, 5220)
ignorehitpause 	= 0
persistent	= 0

;==============================================
;Enemy Attack Checks (For Training Mode Stuff)
;==============================================
[State 0, Mapadd]
type 		= MapSet
trigger1 	    = enemy, movetype = A
map 		    = "EnemyATK"
value 		    = 1
ignorehitpause 	= 1
persistent 		= 1
[State 0, Mapadd]
type 		= MapSet
trigger1 	    = enemy, movetype != A
map 		    = "EnemyATK"
value 		    = 0
ignorehitpause 	= 1
persistent 		= 1


;================================
;Instant Block - Extras
;================================
[State 0, PowerAdd]
type = PowerAdd
trigger1    = stateno = 150 || stateno = 152 || stateno = 154
trigger1 	= map(IBTimer) > 20 && time = 0
value = gethitvar(hittime) + 30
ignorehitpause = 1
persistent = 0

[State 100, 3] ;No Chip Damage
type = AssertSpecial
trigger1 	= map(IBTimer) > 20 || map(Bguard)
flag = NoGuardDamage

[State 0. MapSet]
type 		= MapSet
trigger1    = stateno = 150 || stateno = 152 || stateno = 154
trigger1 	= map(IBTimer) > 20 && time = 0
map 		= "IBPalFX"
value 		= 1
ignorehitpause 	= 1
persistent 		= 1

[State 0. MapSet]
type 		= MapAdd
trigger1 	= map(IBPalFX)
map 		= "IBPalFX"
value 		= 1
ignorehitpause 	= 1
persistent 		= 1

[State 0, PalFX Perfect Guard]
type = PalFX
trigger1 = map(IBPalFX)
time = 1
add = cond(170 - map(IBPalFX) * 8 >= 0, 170 - map(IBPalFX) * 8, 0),cond(170 - map(IBPalFX) * 8 >= 0, 170 - map(IBPalFX) * 8, 0),cond(170 - map(IBPalFX) * 8 >= 0, 170 - map(IBPalFX) * 8, 0)
ignorehitpause = 1

[State 0, MapSet] ;Map for "remembering" that you instant blocked
type = MapSet
trigger1 = map(IBTimer) > 20 && time = 0
map = "IBparam"
value = 10
[State 0, MapSet] ;Tick Down
type = MapAdd
trigger1 = map(IBParam)
map = "IBparam"
value = -1

