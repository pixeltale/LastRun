trigger2 = AILevel && ceil(random<(200*(AILevel**2/64.0)));(random<200+(10*var(54)))
trigger2 = statetype=S && (enemynear,movetype=A) && (enemynear,statetype=C)
statetype = C
physics = C
[State 150, Low to High]
