type    = S
physics = S
ctrl = 0
velset = 0, 0
anim = 40

[State 40, 1]
type = VarSet
trigger1 = time = 0
sysvar(3) = 0
[State 170, 1]
type = NotHitBy
trigger1 = 1
value = , AT
time = 1

[State - Air Option Limiter - Double Jump]
type 		= mapset
trigger1 		= !time
map 			= "DoubleJump"
value 		= const(AirJumps)
[State - Air Option Limiter - Double Jump]
type 		= mapset
trigger1 		= !time
