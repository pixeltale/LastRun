map = "TERMINA.ACTIVE"
value = 1
ignorehitpause = 1
[State 0, MapSet] ;START
type = MapSet
trigger1 = map(TERMINA.ACTIVE)
map = "TERMINA.TIME"
value = 600 - 300 * (combocount > 0)
ignorehitpause = 1

[State 0, SuperPause]
type = SuperPause
trigger1 = time = 0
time = 20
sound = 20,0
pos = 0,0
movetime = 20
darken = 1
p2defmul = 1
poweradd = 0
unhittable = 1

[State 4000, 1]
type = ChangeState
trigger1 = !animtime
value = 0
ctrl = 1


;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, 3] ;Change palette
type = RemapPal
trigger1 = 1
source = 1,1
dest = 1,palno

[State 5900, 4] ;Intro for round 1
type = ChangeState
trigger1 = roundno = 1
value = 190

[State 5900, 5] ;All other rounds
type = ChangeState
trigger1 = 1
value = 0


[Statedef -1] ;Common CMD actions. Mostly utilized for system mechanics and universal actions.

;===========================================================================
;UNIVERSAL ACTIONS ----------------------------------------------------------
;===========================================================================
[State -1, TERMINA]
type = ChangeState
value = 4000
triggerall = command = "TERMINA"
triggerall = statetype != A && stateno < 3000 && movetype != H
trigger1 = MAP(pursuit.MAX)

;PARRY
[State -1, PARRY]
type = ChangeState
value = 900 + 10*statetype = A
triggerall = command = "D" || (prevstateno = 5120) && command = "HOLD_D" || (prevstateno = 905 || prevstateno = 915) && command = "Multiparry"
trigger1 = ctrl

[State -1, Pursuit Dash Cancel]
type = ChangeState
value = 100
triggerall = command = "FF"
triggerall = statetype != A
triggerall = movecontact > 0 && movecontact <= 6
triggerall = stateno < 3000
trigger1 = MAP(PURSUITCANCEL_NORMALS) && (map(Pursuit) >= 333 || map(TERMINA.ACTIVE)) ;Dash Cancel Normals
trigger2 = MAP(PURSUITCANCEL_SPECIALS) && (map(Pursuit) >= 666 || map(TERMINA.ACTIVE)) ;Dash Cancel Specials

[State -1, Grab] ;Throw
type = ChangeState
value = 800
trigger1 = command = "Throw"
trigger1 = statetype != A
trigger1 = ctrl || (stateno = [200,230] && time < 2) && prevstateno != [200, 430]

;Air Raid
[State -1, Super Jump Cancel]
type = ChangeState
value = 55
triggerall = statetype != A
triggerall = command = "holdup" || command = "up"
trigger1 = Map(JC)


;==============================================================================
;------------------------------------------------------------------------------
[Statedef +1]
;===============================================================================
; ------- Jump Cancel --------
;===============================================================================
[State 0, Jump Cancel Reset]
type 		= MapSet
trigger1 		= time = 0
map 			= "JC"
value 		    = 0
ignorehitpause 	= 0


[Statedef -2]


;===============================================================================
; ------- Juggle Scaling --------
;===============================================================================
[State -2, Juggle Scaling Timer - Tick Up]
type = MapAdd
trigger1 = combocount && enemy, statetype = A
trigger1 = enemy, stateno != [5220,5259]
map = "JuggleTime"
value = 1
ignorehitpause = 0
persistent = 1
[State -2, Juggle Scaling Timer - Reset]
type = MapSet
trigger1 = !combocount
map = "JuggleTime"
value = 0
ignorehitpause = 1
persistent = 1
[State -2, Juggle State Check]
type = MapSet
trigger1 = map(JuggleTime) < 30 
map = "JuggleScale"
value = 0.9
ignorehitpause = 1
persistent = 1
[State -2, Juggle State Check]
type = MapSet
trigger1 = map(JuggleTime) >= 30
map = "JuggleScale"
value = ((map(juggleTime)+60) * 0.015)
ignorehitpause = 1
persistent = 1

;===============================================================================
; ------- Retribution --------
;===============================================================================
[State -2, Retribution]
type = MapSet
trigger1 = map(PunishCheck) = 1
map = "Retribution"
value = 1
ignorehitpause = 1
persistent = 1
[State -2, Retribution]
type = MapSet
triggerall = enemy, map(ForceRetribution) = 0
trigger1 = enemy, ctrl = 1
map = "Retribution"
value = 0
ignorehitpause = 1
persistent = 1

[State 0, MapSet] 
type = MapSet
triggerall = map(PunishCheck) = 0
trigger1 = enemy, animelemvar(numclsn1) > 0
map = "PunishCheck"
value = 1
[State 0, MapSet] 
type = MapSet
triggerall = map(PunishCheck) = 1
trigger1 = enemy, ctrl
trigger2 = combocount
map = "PunishCheck"
value = 0

[State 0, Custom Afterimage]
type = Explod
trigger1 = combocount
trigger1 = map(Retribution)
trigger1 = time%3=0
anim = anim
animelem = animelemno(0)
animfreeze = 1
ID = 9999
postype = p1
pos = 0,0
facing = 1
vfacing = 1
bindtime = 1
supermovetime = 0
pausemovetime = 0
scale = 1,1.1
velocity = 0, -0.1
sprpriority = -10
ontop = 0
shadow = 0,0,0
ownpal = 1
trans = add
removetime = 20
palfx.time = 40
palfx.sinmul = -55,-255,-255,160
removeongethit = 0
ignorehitpause = 1

;Retribution Activation Slowdown
[State 0, Mapadd]
type 		= MapSet
trigger1 	    = map(PunishCheck) && movehit = 1
map 		    = "SlowdownTime"
value 		    = 15
ignorehitpause 	= 1
persistent 		= 1
[State 0, Mapadd]
type 		    = MapAdd
trigger1 	    = map(PunishCheck) && movehit = 1
map 		    = "Pursuit"
value 		    = 25
ignorehitpause 	= 1
persistent 		= 0
[State 0, Mapadd]
type 		= MapAdd
trigger1 	    = map(PunishCheck) && movehit = 1
map 		    = "Pursuit"
value 		    = -25
ignorehitpause 	= 1
persistent 		= 0
redirectid      = enemynear, id
[State 0, Mapadd]
type 		= MapAdd
trigger1 	    = map(Slowdowntime)
map 		    = "SlowdownTime"
value 		    = -1
ignorehitpause 	= 1
persistent 		= 1

[State 0, BGPalFX]
type = BGPalFX
trigger1 = map(SlowdownTime)
time = 5
add = -(map(SlowdownTime))*1.75,-(map(SlowdownTime))*1.75,-(map(SlowdownTime))*1.75
persistent = 1
ignorehitpause = 1

[State 0, EVERYTHING WILL FREEZE!]
type = Pause
triggerall = map(slowdownTime)
trigger1 = gametime % 2 = 0
time = 2
anim = 99999
pos = 0,0
movetime = 2
darken = 0
p2defmul = 1
unhittable = 1

