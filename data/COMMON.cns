trigger1 = map(CounterHit)	
map = "CounterHit_Flag"
value = 5
ignorehitpause = 1
[State -2, CH - Read for Start Flag] 				;Checks if the opponent is
type = MapAdd	                                    ;attacking or not
trigger1 = map(CounterHit_Flag)	
map = "CounterHit_Flag"
value = -1
ignorehitpause = 1

[State -2, Counter Hit Start Flag] 		;Checks for counterhit starter for the combo.
type = MapSet					
trigger1 = map(CounterHit_Flag)
trigger1 = map(ComboStateCheck)
map = "CHStarter"
value = 1
ignorehitpause = 1

[State -2, Counter Hit Start Reset] 		;Resets the "counterhit starter" value after a combo finishes.
type = MapSet					
trigger1 = !map(ComboStateCheck)
map = "CHStarter"
value = 0
ignorehitpause = 0
